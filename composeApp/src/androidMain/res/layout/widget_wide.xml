<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView android:id="@+id/cover" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:clipToOutline="true" android:contentDescription="@null" />

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_scrim" android:scaleType="fitXY" android:contentDescription="@null" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:gravity="center_vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/art" android:layout_width="40dp" android:layout_height="40dp"
                android:scaleType="centerCrop" android:background="@drawable/widget_note_bg" android:clipToOutline="true"
                android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#F4F4F6" android:textSize="15sp" android:textStyle="bold" android:maxLines="1"
                    android:ellipsize="end" android:text="Nothing playing" />
                <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#B4B4BE" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
                    android:layout_marginTop="3dp" android:text="Tap to open OM Player" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:layout_marginTop="4dp">
            <ImageView android:id="@+id/prev" android:layout_width="44dp" android:layout_height="44dp"
                android:padding="11dp" android:src="@drawable/ic_w_prev" android:contentDescription="Previous track" />
            <ImageView android:id="@+id/play" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="13dp" android:background="@drawable/widget_play_bg"
                android:src="@drawable/ic_w_play" android:contentDescription="Play or pause"
                android:layout_marginStart="12dp" android:layout_marginEnd="12dp" />
            <ImageView android:id="@+id/next" android:layout_width="44dp" android:layout_height="44dp"
                android:padding="11dp" android:src="@drawable/ic_w_next" android:contentDescription="Next track" />
            <ImageView android:id="@+id/discover" android:layout_width="44dp" android:layout_height="44dp"
                android:padding="12dp" android:src="@drawable/ic_w_discover" android:contentDescription="@string/widget_discover"
                android:layout_marginStart="0dp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp" android:layout_gravity="bottom"
        android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress" />
</FrameLayout>
