<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:clipToOutline="true">

    <ImageView android:id="@+id/cover" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:clipToOutline="true" android:contentDescription="@null" />

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_scrim" android:scaleType="fitXY" android:contentDescription="@null" />

    <ImageView android:id="@+id/empty_note" android:layout_width="44dp" android:layout_height="44dp"
        android:layout_gravity="center" android:padding="12dp" android:background="@drawable/widget_note_bg" android:clipToOutline="true"
        android:src="@drawable/ic_w_note" android:contentDescription="@null" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#F4F4F6" android:textSize="14sp" android:textStyle="bold" android:maxLines="2"
            android:ellipsize="end" android:text="Nothing playing" />
        <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#B4B4BE" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
            android:layout_marginTop="2dp" android:text="Tap to open OM Player" />
    </LinearLayout>

    <ImageView android:id="@+id/play" android:layout_width="44dp" android:layout_height="44dp"
        android:layout_gravity="top|end" android:layout_marginTop="12dp" android:layout_marginEnd="12dp"
        android:padding="10dp" android:background="@drawable/widget_play_bg"
        android:src="@drawable/ic_w_play" android:contentDescription="Play or pause" />
</FrameLayout>
