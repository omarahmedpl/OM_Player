<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:clipToOutline="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
        <ImageView android:id="@+id/art" android:layout_width="44dp" android:layout_height="44dp"
            android:scaleType="centerCrop" android:background="@drawable/widget_note_bg" android:clipToOutline="true"
            android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#F4F4F6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1"
                android:ellipsize="end" android:text="Nothing playing" />
            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#B4B4BE" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
                android:text="Tap to open OM Player" />
        </LinearLayout>
        <ImageView android:id="@+id/play" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="11dp" android:src="@drawable/ic_w_play" android:contentDescription="Play or pause" />
    </LinearLayout>
</FrameLayout>
